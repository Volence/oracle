[Desktop Entry]
Type=Application
Name=Oracle
Comment=Empyrean's Genesis / Mega Drive emulator and debugger
# ⚑ THE WHOLE COMMAND LINE LIVES HERE — see the same note in oracle-player.desktop for why the installer
# no longer composes it. `oracle-frontend` takes its ROM POSITIONALLY (`--rom` is not one of its flags),
# which is the opposite of the player, and `--frontend` is what tells the launcher which of the two
# spellings to use.
#
# This entry had the second half of the same defect: `%f` is the right SHAPE for this binary, but a plain
# icon click passes no file, and the frontend then exits with `missing <rom.bin>` and no window. The
# launcher resolves a ROM before either binary is reached, so a click on either icon opens something.
Exec=@LAUNCHER@ --frontend --bin @BIN@ %f
Icon=oracle
Terminal=false
Categories=Game;Emulator;
MimeType=application/x-genesis-rom;
# What the window reports as its class (X11 WM_CLASS via icon.rs; on Wayland minifb sets no app id and KWin
# falls back to the executable name — measured 2026-08-26 — which is the same string). Keep in step with
# icon::WM_CLASS.
StartupWMClass=oracle-frontend
