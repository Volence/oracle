       1/       0 :                     ; ---------------------------------------------------------------------------
       2/       0 :                     ; VDP control-port pending-toggle experiment ROM (clean-room, authored here).
       3/       0 :                     ;
       4/       0 :                     ; Question (VDP recon R1, open cell): after the FIRST word of a two-word VDP
       5/       0 :                     ; command is written to $C00004, which accesses CLEAR the first/second-write
       6/       0 :                     ; toggle? Permitted docs pin "data-port write clears" (Kabuto) and are silent
       7/       0 :                     ; on control-port (status) reads and HV-counter reads; the folklore claim
       8/       0 :                     ; ("status read clears the flag") exists only in non-permitted docs.
       9/       0 :                     ;
      10/       0 :                     ; Method: per cell, arm the toggle with the first word of a VRAM-write command
      11/       0 :                     ; for $0200, apply the probe, then write the AMBIGUOUS word $4300:
      12/       0 :                     ;   - toggle still armed  -> $4300 is the SECOND word (CD5-2=0, A15-14=0):
      13/       0 :                     ;                            completes the VRAM write @ $0200
      14/       0 :                     ;   - toggle cleared      -> $4300 is a FIRST word (CD1-0=01, A13-0=$0300):
      15/       0 :                     ;                            arms a VRAM write @ $0300
      16/       0 :                     ; A data-port write of $BBBB then lands at $0200 (armed) or $0300 (cleared) —
      17/       0 :                     ; both interpretations are writes, so no read-with-write-target lockup hazard.
      18/       0 :                     ; Sentinels $AAAA/$1111/$2222 pre-fill $0100/$0200/$0300; results are read back
      19/       0 :                     ; through the data port into work RAM for the RSP driver.
      20/       0 :                     ;
      21/       0 :                     ; Control block (driver writes before `c`):
      22/       0 :                     ;   $FF9000.b  probe selector: 0 -> none (control: pending persists)
      23/       0 :                     ;                              1 -> status read  (move.w (a5),d0)
      24/       0 :                     ;                              2 -> HV counter read ($C00008)
      25/       0 :                     ;                              3 -> data-port write $CCCC (Kabuto predicts clear)
      26/       0 :                     ;
      27/       0 :                     ; Observable RAM:
      28/       0 :                     ;   $FF8000.w VRAM[$0100]  (sentinel check, expect $AAAA)
      29/       0 :                     ;   $FF8002.w VRAM[$0200]
      30/       0 :                     ;   $FF8004.w VRAM[$0300]
      31/       0 :                     ;   $FF8006.w VRAM[$0202]  (catches the sel-3 "data write did NOT clear" case)
      32/       0 :                     ;   $FF8008.w the probe's read value (status / HV), $0000 for sel 0/3
      33/       0 :                     ;   $FF8010.w done marker $C0DE
      34/       0 :                     ; ---------------------------------------------------------------------------
